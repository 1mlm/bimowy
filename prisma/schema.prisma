generator client {
  provider = "prisma-client"
  output   = "../src/db/prisma-generated"
}

datasource db {
  provider = "postgresql"
}

model Resource {
  id String @id @default(uuid())

  type    ResourceType
  title   String
  aliases String[]
  handle  String
  beta    Boolean      @default(true)
  desc    String?
  tags    Tag[]

  visibility ResourceStatus @default(PUBLIC)

  data Json

  @@unique([handle, type])
}

enum ResourceType {
  TEMPLATE_EXERCISE
}

enum ResourceStatus {
  PUBLIC
  LINKONLY
  PRIVATE
}

model Tag {
  id      String   @id @default(uuid())
  handle  String   @unique
  name    String
  aliases String[]

  resources Resource[]
}
