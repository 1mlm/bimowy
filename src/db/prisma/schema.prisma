generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Resource {
  handle String @id @unique

  title   String
  aliases String[]
  desc    String?
  beta    Boolean  @default(true)

  tags       Tag[]
  type       ResourceType
  visibility ResourceStatus @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  data Json
}

enum ResourceType {
  TEMPLATE_EXERCISE
  ARTICLE
  COURSE
  RESOURCE_GROUP
  TABLE
}

enum ResourceStatus {
  PUBLIC
  LINKONLY
  PRIVATE
}

model Tag {
  id      String   @id @default(uuid())
  handle  String   @unique
  title   String
  aliases String[]

  resources Resource[]
}
