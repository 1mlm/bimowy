generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Resource {
  id String @id @default(uuid())

  type    ResourceType
  handle  String
  
  title   String
  aliases String[]
  beta    Boolean      @default(true)
  desc    String?
  tags    Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visibility ResourceStatus @default(PUBLIC)

  data Json

  @@unique([handle, type])
}

enum ResourceType {
  TEMPLATE_EXERCISE
  ARTICLE
  COURSE
  RESOURCE_GROUP
  TABLE
}

enum ResourceStatus {
  PUBLIC
  LINKONLY
  PRIVATE
}

model Tag {
  id      String   @id @default(uuid())
  handle  String   @unique
  title   String
  aliases String[]

  resources Resource[]
}
